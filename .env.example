# Copy to .env (never commit .env). Every value is optional for local use.
SECRET_KEY=change-me

# Storage: auto = try MongoDB then fall back to local JSON files; mongo; local
STORAGE_BACKEND=auto
# Example Atlas URI (keep it secret):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=autopatch

# Upload limits
MAX_UPLOAD_MB=10
MAX_UNCOMPRESSED_MB=50
MAX_FILES=500
MAX_FILE_MB=2

# Stage 3: AI patch generation. Get a key from Google AI Studio. Never commit .env.
# Leave empty until you have a real key. A placeholder or quoted value is rejected with a specific message.
GEMINI_API_KEY=

# Stage 2: analysis execution (tests and entry points of uploaded projects run in a temporary copy)
ALLOW_EXECUTION=true
PYTEST_TIMEOUT_SECONDS=60
ENTRYPOINT_TIMEOUT_SECONDS=10
TOOL_TIMEOUT_SECONDS=60
MAX_ENTRYPOINTS=3

# Stage 3 options (all optional)
# auto (default) = SDK if it can be imported, otherwise a built-in HTTPS client that needs no extra packages.
# Use rest if Windows Application Control blocks the SDK; sdk to force the SDK.
GEMINI_TRANSPORT=auto
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=180
# Gemini 3 models think before answering, which can exceed the deadline. low = fast (default for gemini-3* models);
# minimal|low|medium|high override it, off = send nothing.
GEMINI_THINKING_LEVEL=low
# Extra attempts after an HTTP 503 (overloaded) only
GEMINI_RETRIES=2
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=8192
PATCH_MAX_FILES=3
PATCH_MAX_CHANGED_LINES=200
PATCH_MAX_DIFF_KB=64
PATCH_MAX_CONTEXT_KB=60

# Backend V2: Host headers other than localhost, 127.0.0.1 and [::1] are refused. Add extra names here (comma separated) if you
# deliberately reach AutoPatch under another local name, e.g. ALLOWED_HOSTS=myhost.local
ALLOWED_HOSTS=
